{
  "name": "natueve-web-frontend",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.2.21",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src .vscode README.md package.json components.json next.config.ts tsconfig.json",
    "lint:fix": "biome check src .vscode README.md package.json components.json next.config.ts tsconfig.json --write",
    "format": "biome format --write src .vscode README.md package.json components.json next.config.ts tsconfig.json",
    "format:check": "biome format src .vscode README.md package.json components.json next.config.ts tsconfig.json",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check": "biome check src .vscode README.md package.json components.json next.config.ts tsconfig.json && next typegen && tsc --noEmit",
    "msw:init": "msw init public --save",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "lucide-react": "^0.525.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "jsdom": "^25.0.1",
    "msw": "^2.9.1",
    "postcss": "^8.5.6",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.148.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
