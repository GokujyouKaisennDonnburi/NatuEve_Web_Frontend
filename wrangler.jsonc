{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natueve-web-frontend",
  // workers.dev と Preview URL は無効にする。どちらも省略すると Worker 側の設定を変えないか（preview_urls）、
  // routes が空のときに有効になる（workers_dev）ため、明示する（wrangler 4.150.0。docs/Deployment.md「割り当て方法」）。
  "workers_dev": false,
  "preview_urls": false,
  // Custom Domain はここに書かず、管理者がダッシュボードで割り当てる。
  // CI のトークンにルートを変える権限を付けないため（ADR-0003 決定 3）。
  "routes": [],
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Worker の実行時変数。OpenNext の populateProcessEnv が文字列のバインディングを
  // process.env に供給するため、src/lib/csp.ts がランタイムに読める。
  // CI のワークフローの env: の値はビルド時にしか届かず、next-env.mjs に入るのは
  // .env 系ファイルの値だけ（CI は .env を使わない）ため、実行時の値は vars で渡す。
  // ローカルの preview（wrangler dev）では .dev.vars で上書きできる。
  // vars は env に引き継がれないため、env.staging でも宣言し直す（wrangler 4.150.0）。
  "vars": {
    // nonce の CSP を enforce（Content-Security-Policy）で付ける（#412。ADR-0005 決定 3）。
    // 未設定でも enforce になるが、"false" と明示する。vars にない変数は、ビルド時に読んだ
    // .env 系ファイルの値で埋まる（OpenNext の populateProcessEnv）ため、.env.production に
    // CSP_REPORT_ONLY=true がコミットされても、本番が Report-Only に戻らないようにする。
    // 障害のときに "true" にすると Report-Only に戻るが、ほかに CSP がないため、
    // その間は有効な CSP が 1 つもなくなる（docs/Deployment.md「戻し方」）。
    "CSP_REPORT_ONLY": "false",
    // 本番の CSP に開発用の R2（assets-dev.natuportal.org）を入れない（NatuEve_API ADR-0039 決定 6）。
    // "false" と明示する理由は CSP_REPORT_ONLY と同じ（.env.production の値で埋まらないようにする）。
    "USE_DEV_ASSETS": "false"
  },
  "images": {
    // 画像最適化（Cloudflare Images）を有効化する。参考: https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "natueve-web-frontend"
    }
  ],
  // 検証環境（ADR-0003 決定 4）。`opennextjs-cloudflare build --env staging`・`deploy --env staging` で使う。
  // Worker の名前は API 側（natueve-api-relay-stg）に揃える。Worker は管理者がダッシュボードで作る。
  "env": {
    "staging": {
      "name": "natueve-web-frontend-stg",
      // routes・workers_dev・preview_urls は最上位から引き継がれるが、最上位の変更に左右されないよう明示する。
      "routes": [],
      "workers_dev": false,
      "preview_urls": false,
      // images・services・vars は env に引き継がれないため、宣言し直す。
      "vars": {
        // 本番と同じく enforce（#412）。"false" と明示する理由は最上位の vars と同じ。
        "CSP_REPORT_ONLY": "false",
        // 検証環境は開発用の R2（assets-dev.natuportal.org）の画像を表示する（#353）。
        // ビルド時の remotePatterns（next.config.ts）は CI のビルドステップの env: で
        // USE_DEV_ASSETS=true にしてあり、この vars は実行時に CSP の img-src に
        // 開発用の取得元を足すためのもの（src/lib/csp.ts）。
        "USE_DEV_ASSETS": "true"
      },
      "images": {
        "binding": "IMAGES"
      },
      "services": [
        {
          // 検証用の Worker 自身を指す（最上位の値をそのまま写すと本番の Worker を指してしまう）。
          "binding": "WORKER_SELF_REFERENCE",
          "service": "natueve-web-frontend-stg"
        }
      ]
    }
  }
}
