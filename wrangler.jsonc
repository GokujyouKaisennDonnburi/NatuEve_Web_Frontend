{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natueve-web-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    // 画像最適化（Cloudflare Images）を有効化する。参考: https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "natueve-web-frontend"
    }
  ]
}
